{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay: a tool-calling customer support agent for a (mock) Shopify store, measured by an eval suite.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "chat": "tsx src/channels/simulator.ts",
    "server": "tsx src/server.ts",
    "sms": "tsx src/cli/sms.ts",
    "queue": "tsx src/cli/queue.ts",
    "slack-test": "tsx src/cli/slack-test.ts",
    "shopify-check": "tsx src/cli/shopify-check.ts",
    "shopify-seed": "tsx src/cli/shopify-seed.ts",
    "models": "tsx src/cli/models.ts",
    "eval": "tsx src/eval/run.ts",
    "ab": "tsx src/eval/ab.ts",
    "rejudge": "tsx src/eval/rejudge.ts",
    "judge-agreement": "tsx src/eval/judge-agreement.ts",
    "rescore": "tsx src/eval/rescore.ts",
    "test": "tsx --test --test-force-exit test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.next.json",
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "synthetic": "tsx src/cli/synthetic.ts",
    "dev:preview": "node scripts/dev-preview.mjs",
    "start:preview": "node scripts/dev-preview.mjs --start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.66.0",
    "marked": "18.1.2",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.19",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "twilio": "^6.3.0",
    "typescript": "^7.0.2"
  }
}
