{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay: a tool-calling customer support agent for a (mock) Shopify store, measured by an eval suite.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "chat": "tsx src/channels/simulator.ts",
    "server": "tsx src/server.ts",
    "sms": "tsx src/cli/sms.ts",
    "queue": "tsx src/cli/queue.ts",
    "slack-test": "tsx src/cli/slack-test.ts",
    "shopify-check": "tsx src/cli/shopify-check.ts",
    "shopify-seed": "tsx src/cli/shopify-seed.ts",
    "models": "tsx src/cli/models.ts",
    "eval": "tsx src/eval/run.ts",
    "ab": "tsx src/eval/ab.ts",
    "rejudge": "tsx src/eval/rejudge.ts",
    "rescore": "tsx src/eval/rescore.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "twilio": "^6.3.0",
    "typescript": "^7.0.2"
  }
}
