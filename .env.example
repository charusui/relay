# Copy to .env and fill in yourself. Never commit .env.
# Everything here is free: no card or billing needed.

# Which free provider runs the agent: gemini | groq | ollama
RELAY_PROVIDER=gemini

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
# Find IDs your key can use with:  npm run models -- gemini
RELAY_GEMINI_MODEL=
# Client-side cap on requests per minute (stay under the free limit)
RELAY_GEMINI_RPM=8

# Groq (free key, no card: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-key
# Find IDs with:  npm run models -- groq   (pick one that supports tool calling)
RELAY_GROQ_MODEL=
RELAY_GROQ_RPM=20

# Eval judge: a DIFFERENT model from the agent (avoids self-preference).
# Keep it fixed: runs are only comparable when judged by the same judge.
RELAY_JUDGE_PROVIDER=gemini
# Judge model (separate free quota from the agent model)
RELAY_JUDGE_MODEL=gemini-3.1-flash-lite

# Optional, local and free but slow on small PCs
# OLLAMA_BASE_URL=http://localhost:11434/v1
# RELAY_OLLAMA_MODEL=

# Optional, PAID (not part of a Claude Pro plan). Unused unless RELAY_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# RELAY_ANTHROPIC_MODEL=claude-haiku-5-5

# Where the local Postgres (PGlite) database lives
# RELAY_DB_DIR=.data/relay-db

# ---------------------------------------------------------------- milestone 2
# All optional. Leave blank until you set up each free account (see README:
# "Accounts you set up last").

# SMS webhook (Twilio format). Without a token the server uses a local-only
# dev token, which is fine for `npm run sms`. Set your real Twilio auth token
# here only when Twilio will call a public URL.
# TWILIO_AUTH_TOKEN=
# Public URL Twilio calls (e.g. a free tunnel URL); signatures are checked against it.
# RELAY_PUBLIC_URL=

# Slack hand-off alerts: an Incoming Webhook URL from a free Slack workspace.
# SLACK_WEBHOOK_URL=

# Shopify development store (free Shopify Partner account). From the Dev
# Dashboard app: the store domain, the app's client ID and client secret.
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_STORE_NAME=Pinecrest Supply
